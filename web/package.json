{
  "name": "gcoj-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13.0 <23 || >=24" },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "check": "npm run contracts:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "lossless-json": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
