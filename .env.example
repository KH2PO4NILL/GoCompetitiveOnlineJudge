# Local development only. `make infra-env` creates .env with random secrets.
# 防止3306端口冲突
MYSQL_PORT=3307
MYSQL_DATABASE=go_coj
MYSQL_USER=go_coj
MYSQL_PASSWORD=replace_with_random_password
MYSQL_ROOT_PASSWORD=replace_with_random_root_password

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_random_password

ETCD_PORT=2379

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=localadmin
MINIO_ROOT_PASSWORD=replace_with_random_password
MINIO_BUCKET=problem-test-data

AUTH_MYSQL_DSN='go_coj:replace_with_random_password@tcp(127.0.0.1:3307)/go_coj?charset=utf8mb4&parseTime=true&loc=UTC'
AUTH_REDIS_PASSWORD=replace_with_random_password
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_bytes
AUTH_INTERNAL_PROBLEM_TOKEN=replace_with_random_service_token
AUTH_INTERNAL_CONTEST_TOKEN=replace_with_random_service_token
AUTH_MAIL_USERNAME=your_real_email
AUTH_MAIL_PASSWORD=go_and_turn_on_smtp_service_for_your_email
AUTH_MAIL_FROM=your_real_email
PROBLEM_MYSQL_DSN='go_coj:replace_with_random_password@tcp(127.0.0.1:3307)/go_coj?charset=utf8mb4&parseTime=true&loc=UTC'
PROBLEM_REDIS_PASSWORD=replace_with_random_password
PROBLEM_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
PROBLEM_OBJECT_STORAGE_REGION=us-east-1
PROBLEM_OBJECT_STORAGE_BUCKET=problem-test-data
PROBLEM_OBJECT_STORAGE_ACCESS_KEY=localadmin
PROBLEM_OBJECT_STORAGE_SECRET_KEY=replace_with_random_password
PROBLEM_INTERNAL_SUBMIT_TOKEN=replace_with_random_service_token
PROBLEM_INTERNAL_JUDGE_TOKEN=replace_with_random_service_token
PROBLEM_INTERNAL_CONTEST_TOKEN=replace_with_random_service_token
CONTEST_MYSQL_DSN='go_coj:replace_with_random_password@tcp(127.0.0.1:3307)/go_coj?charset=utf8mb4&parseTime=true&loc=UTC'
SUBMIT_MYSQL_DSN='go_coj:replace_with_random_password@tcp(127.0.0.1:3307)/go_coj?charset=utf8mb4&parseTime=true&loc=UTC'
CONTEST_INTERNAL_PROBLEM_TOKEN=replace_with_random_service_token
CONTEST_INTERNAL_SUBMIT_TOKEN=replace_with_random_service_token
