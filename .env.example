# Local development only. `make infra-env` creates .env with random secrets.
# 防止3306端口冲突
MYSQL_PORT=3307
MYSQL_DATABASE=go_coj
MYSQL_USER=go_coj
MYSQL_PASSWORD=replace_with_random_password
MYSQL_ROOT_PASSWORD=replace_with_random_root_password

REDIS_PORT=6379
REDIS_PASSWORD=replace_with_random_password

ETCD_PORT=2379

AUTH_MYSQL_DSN='go_coj:replace_with_random_password@tcp(127.0.0.1:3307)/go_coj?charset=utf8mb4&parseTime=true&loc=UTC'
AUTH_REDIS_PASSWORD=replace_with_random_password
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_bytes
